# Backend Environment Variables Example
# Copy this file to .env and fill in your actual values

# Google Gemini API Key
# Get yours at: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Twitter API Bearer Token
# Get yours at: https://developer.twitter.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# Metal Price API Key
# Get yours from your metals API provider
METAL_PRICE_API_KEY=your_metal_price_api_key_here

# CORS Configuration (update after frontend deployment)
CORS_ORIGINS=http://localhost:5173

# Server Configuration
PORT=8000
HOST=0.0.0.0

# MongoDB (if used)
MONGODB_URI=your_mongodb_connection_string

# Other API Keys
# Add any other API keys your backend needs
